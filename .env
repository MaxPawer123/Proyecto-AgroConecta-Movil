# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO DE DESARROLLO — AgroConecta
# ─────────────────────────────────────────────────────────────────────────────
# Por defecto la app usa Vercel (producción) incluso en desarrollo.
# Si necesitas probar contra tu backend local, descomenta EXPO_PUBLIC_USE_LAN
# y asegúrate de que BACKEND_IP en http/index.ts tenga tu IP actual.

# URL de producción en Vercel (ya está hardcodeada en http/index.ts como VERCEL_URL)
# Descomenta la siguiente línea SOLO si quieres sobreescribir la URL de Vercel:
EXPO_PUBLIC_API_URL=https://proyecto-agro-conecta-backend.vercel.app

# Desarrollo LAN interno — descomenta esta línea para usar la IP local:
# EXPO_PUBLIC_USE_LAN=true
